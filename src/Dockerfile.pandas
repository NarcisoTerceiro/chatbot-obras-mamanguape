# Opcional, adapte ao seu projeto antes de usar.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-pandas.txt ./
RUN python3 -m venv /opt/pandas-env && /opt/pandas-env/bin/pip install --no-cache-dir -r requirements-pandas.txt
ENV PYTHON_BIN=/opt/pandas-env/bin/python
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
CMD ["npm", "start"]
