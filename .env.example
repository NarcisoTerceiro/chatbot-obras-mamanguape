# ==========================================================
#  Copie este arquivo para ".env" e preencha com seus valores
#  cp .env.example .env
# ==========================================================

# ---- Servidor ----
PORT=3000

# ---- WhatsApp Cloud API (Meta) ----
# Token de acesso do seu App (temporario na fase de teste, permanente na producao)
WHATSAPP_TOKEN=EAAG...cole_aqui
# ID do numero de telefone (aparece no painel do App, em "API do WhatsApp")
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Um texto QUALQUER inventado por voce. Voce vai digitar o mesmo valor no painel da Meta
# ao configurar o Webhook. Serve para a Meta provar que o webhook e seu.
VERIFY_TOKEN=meu_token_secreto_123
# Versao da Graph API (confira a atual no painel do App; v22.0 e um valor recente e estavel)
GRAPH_API_VERSION=v22.0

# ---- Groq (IA generativa) ----
GROQ_API_KEY=gsk_...cole_aqui
# Modelo gratuito atual. openai/gpt-oss-120b substitui o llama-3.3-70b (descontinuado em jun/2026).
# Alternativas free: openai/gpt-oss-20b (mais rapido) ou qwen/qwen3.6-27b.
GROQ_MODEL=openai/gpt-oss-120b

# ---- Google Sheets ----
# ID da planilha (esta na URL: docs.google.com/spreadsheets/d/ ESTE_TRECHO /edit)
GOOGLE_SHEETS_ID=cole_o_id_da_planilha
# Abas que o bot deve ler (separadas por virgula, exatamente como aparecem na planilha)
SHEETS_TABS=EM_ANDAMENTO,EM_LICITACAO,EM_PROJETO,PAVIMENTACAO,PENDENCIAS

# Credencial da Conta de Servico do Google. Escolha UMA das duas opcoes:
#  OPCAO A (rodando local) - caminho para o arquivo .json baixado do Google Cloud:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#  OPCAO B (deploy Render/Railway) - cole o CONTEUDO do .json inteiro numa unica linha aqui.
#  Se GOOGLE_SERVICE_ACCOUNT_JSON estiver preenchida, ela tem prioridade sobre o caminho acima.
GOOGLE_SERVICE_ACCOUNT_JSON= 

GEMINI_API_KEY=AQ.Ab8RN6Isy4Sf_lug1qcRHubxQmafHZBX_zMGzTergOgxu1bp7w
GEMINI_MODEL=gemini-flash-latest
