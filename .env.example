# ==========================================================
#  Copie este arquivo para ".env" e preencha com seus valores
#  cp .env.example .env
#  NUNCA coloque chaves/segredos reais aqui — este arquivo vai para o GitHub.
# ==========================================================

# ---- Servidor ----
PORT=3000

# ---- WhatsApp Cloud API (Meta) ----
# Token de acesso do seu App (temporario na fase de teste, permanente na producao)
WHATSAPP_TOKEN=EAAG...cole_aqui
# ID do numero de telefone (aparece no painel do App, em "API do WhatsApp")
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Texto QUALQUER inventado por voce; o mesmo valor vai no painel da Meta (Webhook).
VERIFY_TOKEN=meu_token_secreto_123
# Segredo do App da Meta (App Settings > Basic > App Secret). Valida o webhook.
META_APP_SECRET=cole_o_app_secret_da_meta
# Token para as rotas administrativas (/diagnostico, /sincronizar, /testar-agente).
# Se vazio, usa o VERIFY_TOKEN. Use um valor forte e proprio.
ADMIN_TOKEN=um_token_admin_forte
# Versao da Graph API (confira a atual no painel do App; v22.0 e recente e estavel)
GRAPH_API_VERSION=v22.0

# ---- IA generativa (Groq - gratuita, sem cartao) ----
GROQ_API_KEY=gsk_...cole_aqui
# Modelo gratuito atual. openai/gpt-oss-120b substitui o llama-3.3-70b (descontinuado).
# Alternativa mais rapida: openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
# (Opcional) fallback Gemini, se tiver uma chave propria. Deixe vazio se nao usar.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---- Google Sheets (o bot le a planilha DIRETO, sem banco) ----
# ID da planilha (esta na URL: docs.google.com/spreadsheets/d/ ESTE_TRECHO /edit)
GOOGLE_SHEETS_ID=cole_o_id_da_planilha
# Abas que o bot deve ler. VAZIO = le TODAS as abas (igual ao Data Formulator).
# Preencha (por virgula) so se quiser restringir a algumas abas.
SHEETS_TABS=
# Abas a NAO ler quando SHEETS_TABS esta vazio (ex.: Resumo,Instrucoes).
SHEETS_TABS_IGNORAR=

# Credencial da Conta de Servico do Google. Escolha UMA das duas opcoes:
#  OPCAO A (rodando local) - caminho para o arquivo .json baixado do Google Cloud:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
#  OPCAO B (deploy) - cole o CONTEUDO do .json inteiro numa unica linha.
#  Se preenchida, tem prioridade sobre o caminho acima.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Sandbox Python (opcional, modelo "Data Formulator" completo) ----
# Se preenchido, o bot faz a IA ESCREVER CÓDIGO pandas e roda no sandbox
# (pasta sandbox/, outro serviço) para calcular sobre a planilha. Se vazio,
# o bot usa o modo alternativo (planilha + contagens no contexto).
SANDBOX_URL=
SANDBOX_TOKEN=

# (Opcional) limite de caracteres dos dados enviados a IA no modo alternativo.
# DADOS_MAX_CHARS=48000
# (Opcional) tentativas de correção do código pela IA (self-healing).
# AGENTE_MAX_REPAROS=2
